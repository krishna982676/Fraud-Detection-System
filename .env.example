# ==============================================================================
# SentinelX Fraud Detection Engine - Environment Configuration Template
# Copy this file to .env before starting the application: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Service URLs
# ------------------------------------------------------------------------------
PORT=8080
SERVER_PORT=8080
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 2. Database Configuration
# Default: Embedded file-backed H2 (PostgreSQL compatibility mode)
# Production: Set to PostgreSQL connection string
# ------------------------------------------------------------------------------
DB_URL=jdbc:h2:file:./data/frauddb;MODE=PostgreSQL;DEFAULT_NULL_ORDERING=HIGH;DB_CLOSE_DELAY=-1
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
JPA_PLATFORM=org.hibernate.dialect.H2Dialect

# Example PostgreSQL configuration (uncomment for production):
# DB_URL=jdbc:postgresql://localhost:5432/frauddb
# DB_USER=postgres
# DB_PASSWORD=your_secure_db_password
# DB_DRIVER=org.postgresql.Driver
# JPA_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Tokens
# HMAC-SHA-256 secret (minimum 256 bits / 32 characters)
# ------------------------------------------------------------------------------
JWT_SECRET=sentinelx-super-secret-jwt-key-must-be-at-least-256-bits-long-for-hmac-sha-256-production-use!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 4. Fraud Engine Threshold Defaults
# ------------------------------------------------------------------------------
FRAUD_DETECTION_THRESHOLD=0.70
FRAUD_MEDIUM_THRESHOLD=0.40
FRAUD_SYNTHETIC_ROWS=20000
FRAUD_RATIO=0.02

# ------------------------------------------------------------------------------
# 5. JVM Memory Allocations
# Serving default: 256m - 768m | Training default: -Xmx2g
# ------------------------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx768m

# ------------------------------------------------------------------------------
# 6. Optional SMTP Mail Server (Alert notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# 7. Optional SaaS Billing / Razorpay Integration
# ------------------------------------------------------------------------------
BILLING_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_test
RAZORPAY_PLAN_STARTER=plan_starter_monthly
RAZORPAY_PLAN_GROWTH=plan_growth_monthly
RAZORPAY_PLAN_ENTERPRISE=plan_enterprise_custom

# ------------------------------------------------------------------------------
# 8. Frontend Vite Environment Defaults (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws/alerts
